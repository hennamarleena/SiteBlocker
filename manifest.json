{
    "manifest_version": 3,
    "name": "SiteBlocker",
    "description": "Blocking distracting websites",
    "background": {
        "service_worker": "background.js"
    },
    "version": "0.1",
    "permissions": ["activeTab", "storage", "tabs", "declarativeNetRequest", "declarativeNetRequestFeedback", "declarativeNetRequestWithHostAccess"],
    "host_permissions" :["http://*/*", "https://*/*"], 
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "options_page": "options.html"
}



